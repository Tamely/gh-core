# Copy to server/.env (git-ignored) and fill in. No quotes: docker --env-file keeps them.
# Leave a provider's lines out and auth-dev prints that channel's codes instead.
# POSTMARK_SERVER_TOKEN=POSTMARK_API_TEST checks requests without sending.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
