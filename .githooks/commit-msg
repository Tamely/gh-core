#!/bin/sh
# Reject commit messages that credit an AI as an author or contributor.
# Enable with: git config core.hooksPath .githooks

if grep -Eiq '^[[:space:]]*co-authored-by:.*(claude|anthropic|openai|copilot|chatgpt|codex|cursor|gemini)' "$1" \
  || grep -Eiq 'generated (with|by) .*(claude|codex|copilot|chatgpt|cursor|gemini)' "$1"; then
  echo "commit-msg: AI attribution lines aren't allowed in this repo (see AGENTS.md)." >&2
  echo "Remove the Co-Authored-By / 'Generated with' line and commit again." >&2
  exit 1
fi
